FROM node:22.23.4-alpine AS compile
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY lib ./lib
COPY scripts ./scripts
RUN node scripts/build-scratch-runtime.cjs

FROM node:22.23.4-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=compile /app/scratch-runtime ./scratch-runtime
USER node
CMD ["node", "scratch-runtime/operator.cjs", "serve"]
