FROM node:22.23.4-bookworm-slim AS compile
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY lib ./lib
COPY scripts ./scripts
RUN node scripts/build-scratch-runtime.cjs

FROM node:22.23.4-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=compile /app/scratch-runtime ./scratch-runtime
USER node
CMD ["node", "scratch-runtime/operator.cjs", "serve"]
